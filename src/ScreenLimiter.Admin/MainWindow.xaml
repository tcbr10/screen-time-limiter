<Window x:Class="ScreenLimiter.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenLimiter.Admin"
        Title="{local:T app.title}" Width="860" Height="660" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource Text}" Background="White" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <DockPanel x:Name="Root">

        <!-- Header bar and title bar in one: app name, whether the service is protecting this PC, window buttons. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Height="37">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Caption}" Content="{StaticResource IconMin}" Click="Min_Click" AutomationProperties.Name="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource Caption}" Content="{StaticResource IconMax}" Click="Max_Click" AutomationProperties.Name="Maximize" />
                    <Button Style="{StaticResource Caption}" Content="{StaticResource IconClose}" Tag="close" Click="Close_Click" AutomationProperties.Name="Close" />
                </StackPanel>
                <StackPanel x:Name="ServiceBadge" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Viewbox Width="16" Height="16" FlowDirection="LeftToRight" Margin="0,0,6,0">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="ServiceIcon" Data="{StaticResource IconShieldCheck}" Stroke="{StaticResource Success}" StrokeThickness="2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="ServiceState" FontSize="13" Foreground="{StaticResource Success}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Viewbox Width="16" Height="16" FlowDirection="LeftToRight" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconClock}" Stroke="{StaticResource Secondary}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{local:T app.title}" FontSize="13" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Users, with the parent PIN and language at the bottom -->
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10">
                        <StackPanel>
                            <Button Click="Pin_Click" HorizontalContentAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" FlowDirection="LeftToRight" Margin="0,0,6,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource IconKey}" Stroke="{StaticResource Secondary}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{local:T pin.button}" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="PinState" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,8" />
                            <ComboBox x:Name="LanguageBox" SelectionChanged="Language_Changed" AutomationProperties.Name="{local:T admin.language}" />
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Text="{local:T admin.users}" Foreground="{StaticResource Muted}" FontSize="12" Margin="20,12,20,6" />
                    <ListBox x:Name="UsersList" BorderThickness="0" Background="Transparent" Padding="10,0" SelectionChanged="User_Selected"
                             ItemContainerStyle="{StaticResource UserRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <!-- Avatar: initials, or a lock for admins -->
                                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="{Binding AvatarBrush}" Margin="0,0,10,0">
                                        <Grid>
                                            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource AccentText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding InitialsVisibility}" />
                                            <Viewbox Width="14" Height="14" FlowDirection="LeftToRight" Visibility="{Binding LockVisibility}">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconLock}" Stroke="{StaticResource Secondary}" StrokeThickness="2" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Editor -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Editor" Margin="16,14" IsEnabled="False">

                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="GrantButton" DockPanel.Dock="Right" Click="Grant_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconPlus}" Stroke="{StaticResource Text}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{local:T edit.addtime}" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="GrantMenu" Placement="Bottom" />
                            </Button.ContextMenu>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="UserName" Text="{local:T admin.select}" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" />
                            <Border x:Name="Badge" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="BadgeText" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock x:Name="AdminNote" Text="{local:T admin.adminnote}" Foreground="{StaticResource Secondary}"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" />

                    <StackPanel x:Name="PolicyPanel">
                        <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="ModeNone" GroupName="Mode" Style="{StaticResource Segment}" Content="{local:T mode.none}" Checked="Mode_Changed" />
                                <RadioButton x:Name="ModeDaily" GroupName="Mode" Style="{StaticResource Segment}" Content="{local:T mode.daily}" Checked="Mode_Changed" />
                                <RadioButton x:Name="ModeWeekly" GroupName="Mode" Style="{StaticResource Segment}" Content="{local:T mode.weekly}" Checked="Mode_Changed" />
                                <RadioButton x:Name="ModeHours" GroupName="Mode" Style="{StaticResource Segment}" Content="{local:T mode.hours}" Checked="Mode_Changed" />
                            </UniformGrid>
                        </Border>

                        <CheckBox x:Name="SameBox" Content="{local:T edit.same}" Margin="0,12,0,4"
                                  Checked="Same_Changed" Unchecked="Same_Changed" />

                        <!-- Daily limit: one slider per row -->
                        <ItemsControl x:Name="DailyRows" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="720" TickFrequency="15" IsSnapToTickEnabled="True"
                                                SmallChange="15" LargeChange="60" Value="{Binding Minutes, Mode=TwoWay}"
                                                AutomationProperties.Name="{Binding Label}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MinutesText}" FontWeight="Medium"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Weekly limit -->
                        <StackPanel x:Name="WeeklyPanel" Margin="0,8,0,0">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:T edit.weekly.total}" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                                <Slider x:Name="WeeklySlider" Grid.Column="1" Minimum="0" Maximum="4200" TickFrequency="30" IsSnapToTickEnabled="True"
                                        SmallChange="30" LargeChange="120" ValueChanged="Weekly_Changed" AutomationProperties.Name="{local:T edit.weekly.total}" />
                                <TextBlock x:Name="WeeklyText" Grid.Column="2" FontWeight="Medium" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:T edit.weekly.cap}" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                                <Slider x:Name="CapSlider" Grid.Column="1" Minimum="0" Maximum="720" TickFrequency="15" IsSnapToTickEnabled="True"
                                        SmallChange="15" LargeChange="60" ValueChanged="Weekly_Changed" AutomationProperties.Name="{local:T edit.weekly.cap}" />
                                <TextBlock x:Name="CapText" Grid.Column="2" FontWeight="Medium" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{local:T edit.weekly.note}" Foreground="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Allowed hours: from / to per row. Times stay left-to-right in Hebrew too. -->
                        <ItemsControl x:Name="HoursRows" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="{Binding Label}" Width="100" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding Start, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                 FlowDirection="LeftToRight" TextAlignment="Center" MaxLength="5" AutomationProperties.Name="{Binding Label}" />
                                        <TextBlock Text="{local:T edit.hours.to}" Margin="10,0" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding End, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                 FlowDirection="LeftToRight" TextAlignment="Center" MaxLength="5" AutomationProperties.Name="{Binding Label}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Options that apply to every mode -->
                        <StackPanel x:Name="OptionsPanel" Margin="0,10,0,0">
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                <DockPanel>
                                    <ComboBox x:Name="TimeUpBox" DockPanel.Dock="Right" Width="190" AutomationProperties.Name="{local:T edit.timeup}" />
                                    <TextBlock Text="{local:T edit.timeup}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                <DockPanel>
                                    <ComboBox x:Name="WarnBox" DockPanel.Dock="Right" Width="190" AutomationProperties.Name="{local:T edit.warn}" />
                                    <TextBlock Text="{local:T edit.warn}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <DockPanel Margin="0,12,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{local:T edit.discard}" Click="Discard_Click" Margin="0,0,8,0" />
                                <Button Content="{local:T edit.save}" Click="Save_Click" Style="{StaticResource Primary}" />
                            </StackPanel>
                            <TextBlock x:Name="Message" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Margin="0,0,12,0" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
