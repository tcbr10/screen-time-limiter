<Window x:Class="ScreenLimiter.Admin.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenLimiter.Admin"
        Title="{local:T pin.title}" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Text}" Background="White">
    <StackPanel Margin="20">
        <TextBlock Text="{local:T pin.help}" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,14" />
        <TextBlock Text="{local:T pin.new}" FontSize="13" Margin="0,0,0,4" />
        <PasswordBox x:Name="First" MaxLength="8" FlowDirection="LeftToRight" AutomationProperties.Name="{local:T pin.new}" />
        <TextBlock Text="{local:T pin.repeat}" FontSize="13" Margin="0,10,0,4" />
        <PasswordBox x:Name="Second" MaxLength="8" FlowDirection="LeftToRight" AutomationProperties.Name="{local:T pin.repeat}" />
        <TextBlock x:Name="Error" Foreground="{StaticResource Danger}" FontSize="13" TextWrapping="Wrap" MinHeight="18" Margin="0,8,0,0" />
        <Button Content="{local:T pin.save}" Click="Save_Click" IsDefault="True" HorizontalAlignment="Right" Margin="0,8,0,0"
                Style="{StaticResource Primary}" />
    </StackPanel>
</Window>
