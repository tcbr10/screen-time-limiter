<Window x:Class="ScreenLimiter.Agent.StatusPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Text}">
    <Border Style="{StaticResource Card}" Width="250">
        <StackPanel>
            <TextBlock x:Name="Caption" Foreground="{StaticResource Secondary}" FontSize="13" />
            <TextBlock x:Name="TimeLeft" FontSize="24" FontWeight="Medium" Margin="0,2,0,8" />
            <!-- Rounded 6px bar: the filled part is how much of the limit has been used. -->
            <Grid x:Name="Bar" Height="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="UsedColumn" Width="0*" />
                    <ColumnDefinition x:Name="LeftColumn" Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{StaticResource Control}" />
                <Border CornerRadius="3" Background="{StaticResource Accent}" />
            </Grid>
            <TextBlock x:Name="Detail" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
